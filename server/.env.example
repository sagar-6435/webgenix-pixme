# ── Core ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# ── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://pixme@localhost:5433/pixme?schema=public"

# ── Redis / BullMQ ───────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
AI_QUEUE_CONCURRENCY=2
# Set to false on API-only instances when running dedicated worker processes.
RUN_WORKERS=true

# ── Auth secrets (generate with `openssl rand -hex 48`) ──────
JWT_ACCESS_SECRET=__ACCESS__
JWT_REFRESH_PEPPER=__REFRESH__
GUEST_JWT_SECRET=__GUEST__
# 32-byte AES key, hex encoded. Rotate carefully: existing embeddings
# become unreadable if this key changes without re-indexing.
BIOMETRIC_ENCRYPTION_KEY=__BIO__

# ── Object storage (MinIO / S3 compatible) ───────────────────
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=pixme
S3_SECRET_KEY=__S3SECRET__
S3_BUCKET=pixme
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=900

# ── Email (console in development) ───────────────────────────
MAIL_TRANSPORT=console
MAIL_FROM="Pixme <contact@pixme.app>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# Only enable for local development. Adds verification/reset tokens to
# API responses so the flow can be tested without SMTP.
EXPOSE_DEV_TOKENS=true

# ── Face recognition ─────────────────────────────────────────
FACE_ENGINE=face-api
FACE_MODEL_DIR=
FACE_DETECTION_MIN_CONFIDENCE=0.55
# Default is intentionally conservative (distance, lower = stricter).
# Each event can override this in its privacy settings.
FACE_MATCH_THRESHOLD=0.52

# ── Seeded demo (change before deploying!) ───────────────────
SEED_ADMIN_EMAIL=admin@pixme.app
SEED_ADMIN_PASSWORD=Admin123!ChangeMe
SEED_DEMO_EMAIL=studio@pixme.app
SEED_DEMO_PASSWORD=Demo123!ChangeMe
